import {
  "moonbitlang/async",
  "moonbitlang/async/js_async",
}

///| Loop #32 G1 probe: js-backend only, run inside a browser Web Worker.
///|
///| Gate the module to the js target. `extern "js"` is rejected outright by the
///| wasm backends, and this probe has no reason to compile there.
pkgtype(kind: "executable")

options(
  targets: { "main.mbt": [ "js" ] },
)
