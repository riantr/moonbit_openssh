import {
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "riantr/moonbit_openssh/src/keyfile",
  "riantr/moonbit_openssh/src/sftpserver",
  "riantr/moonbit_openssh/src/sshd" @sshdsrv,
  "riantr/moonbit_openssh/src/subproc",
  "riantr/moonbit_openssh/src/tcp",
}

///| Native only: this driver listens on a TCP socket and reads files, and
/// neither has a browser target.  The rules it drives (`src/sshd`) are
/// transport-agnostic and build on all four targets -- that is where the
/// tests live.

pkgtype(kind: "executable")

options(
  supported_targets: "+native",
)
