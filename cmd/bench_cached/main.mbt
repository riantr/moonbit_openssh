///| Loop #29 G3 benchmark: Montgomery CIOS with a cached context, 2048-bit modexp x 50

///|
/// The modulus is fixed for an SSH session, so n' and R^2 are precomputed once.
fn main {
  let n_bytes : FixedArray[Byte] = FixedArray::from_array([
    0x7d, 0xba, 0x2e, 0x6d, 0x3d, 0x6f, 0x2b, 0xf9, 0x08, 0xdf, 0x07, 0x72, 0x99,
    0x80, 0xe6, 0x1a, 0x01, 0x41, 0x3e, 0x21, 0xb8, 0x0b, 0x81, 0xe3, 0x1c, 0xa1,
    0x83, 0x44, 0xbf, 0x96, 0x6b, 0xae, 0x3a, 0x2a, 0x9a, 0x98, 0xd6, 0x5f, 0xca,
    0x98, 0xc1, 0xd3, 0x03, 0xe8, 0x7c, 0x73, 0x2f, 0x1e, 0x70, 0x32, 0x4e, 0xa9,
    0x1b, 0xd8, 0x95, 0x40, 0xa6, 0x83, 0xf2, 0x11, 0x4d, 0xea, 0x2d, 0xa4, 0x48,
    0x6b, 0xde, 0x0a, 0x36, 0x03, 0x21, 0xf6, 0x05, 0x4b, 0x77, 0x38, 0xc7, 0xc6,
    0x4f, 0x0b, 0xc1, 0x04, 0xdc, 0x69, 0x3c, 0xf4, 0x96, 0x89, 0x97, 0xfb, 0x7f,
    0x4a, 0x2c, 0x3b, 0x62, 0x20, 0x70, 0xc3, 0x10, 0x14, 0x28, 0xf5, 0x4c, 0x75,
    0x83, 0xdb, 0x28, 0xfc, 0x98, 0xdb, 0x66, 0x3e, 0x0a, 0x0e, 0x2f, 0xfc, 0xda,
    0x3d, 0x78, 0xb1, 0x13, 0x5f, 0x66, 0x98, 0x46, 0xe6, 0x87, 0x62, 0x90, 0xf7,
    0xe7, 0xd0, 0x4c, 0x59, 0x63, 0x5f, 0x54, 0xe5, 0xbd, 0x09, 0x08, 0x1a, 0xd3,
    0x6b, 0xc3, 0x85, 0xd1, 0xe6, 0x91, 0x5a, 0xd9, 0x20, 0x5f, 0xb7, 0xed, 0xc3,
    0x0d, 0xa4, 0x85, 0x2e, 0xa6, 0xbf, 0x2e, 0xb0, 0x87, 0xc3, 0xfe, 0xf8, 0xfb,
    0xa4, 0xd2, 0xa8, 0x7c, 0x61, 0x13, 0x29, 0xb2, 0xf1, 0x2c, 0xf0, 0x41, 0xfd,
    0x8b, 0x16, 0xb5, 0x54, 0x1e, 0xe6, 0xe7, 0xce, 0xcb, 0xc3, 0xf4, 0x72, 0xde,
    0x76, 0xe1, 0xca, 0x82, 0xe3, 0x58, 0xa4, 0x49, 0x3d, 0x9c, 0xc4, 0x80, 0x6d,
    0x6d, 0xe3, 0x96, 0x07, 0xa2, 0x78, 0xb3, 0x1a, 0x33, 0x57, 0xef, 0xc3, 0x63,
    0x99, 0x62, 0x07, 0xdc, 0x85, 0xce, 0x19, 0x67, 0x8e, 0x86, 0x7a, 0xcf, 0xaa,
    0xe8, 0x96, 0xe4, 0x2c, 0x5d, 0xfc, 0x09, 0x40, 0xb9, 0xc3, 0xc3, 0xf7, 0x73,
    0x71, 0xf1, 0x4a, 0x44, 0x75, 0xe3, 0xac, 0x1c, 0xa3,
  ])
  let sig_bytes : FixedArray[Byte] = FixedArray::from_array([
    0x53, 0x6f, 0xc3, 0xad, 0x6f, 0x1b, 0x43, 0x35, 0x24, 0x08, 0x63, 0xf9, 0xf0,
    0xc5, 0xa3, 0x11, 0x44, 0xd7, 0x4b, 0xbc, 0x42, 0x76, 0x42, 0xba, 0x43, 0xbe,
    0x07, 0x61, 0x4d, 0x98, 0xef, 0x53, 0x1d, 0x0f, 0xae, 0xae, 0x45, 0x0f, 0x4f,
    0x0c, 0xa5, 0xdc, 0xb8, 0x1d, 0x93, 0xcc, 0xdb, 0x73, 0xe2, 0xc1, 0x60, 0xe5,
    0x8d, 0xd2, 0x00, 0x18, 0xf2, 0x91, 0xae, 0x90, 0xa6, 0xf3, 0xe5, 0xf4, 0x20,
    0x17, 0x83, 0x92, 0xd2, 0xef, 0xbb, 0x4e, 0x4a, 0xad, 0x39, 0x70, 0x62, 0x26,
    0xf7, 0x7d, 0x6e, 0x8f, 0x6c, 0x87, 0x06, 0xdf, 0xe5, 0x71, 0x38, 0xf8, 0xda,
    0x3d, 0xa2, 0xd1, 0xff, 0x17, 0x90, 0xef, 0xf1, 0x34, 0xb7, 0x3d, 0xa1, 0xa6,
    0x2c, 0x87, 0x60, 0x83, 0x49, 0x8c, 0x82, 0xbf, 0x3b, 0x2d, 0x55, 0x01, 0xab,
    0x36, 0xde, 0x3d, 0x6a, 0xb2, 0xeb, 0x94, 0x06, 0xfb, 0x93, 0x92, 0xea, 0xa2,
    0x9e, 0x81, 0xd5, 0xee, 0x28, 0x1f, 0x72, 0x9c, 0xda, 0x2f, 0x68, 0x5c, 0xfa,
    0xd8, 0x7c, 0x82, 0x5a, 0x54, 0xeb, 0x21, 0xf6, 0xd5, 0x0b, 0xf9, 0xb9, 0x81,
    0x8c, 0x6e, 0x37, 0xf1, 0x6f, 0xf3, 0x9a, 0xd0, 0xa1, 0xeb, 0x22, 0x79, 0x6c,
    0xb6, 0x17, 0x35, 0xe3, 0x84, 0xef, 0x68, 0x5c, 0xa8, 0x62, 0xcf, 0x31, 0xe3,
    0x5d, 0x87, 0x4b, 0x98, 0xae, 0xbb, 0xef, 0x70, 0x70, 0x30, 0x21, 0x58, 0x40,
    0xcc, 0xc3, 0x26, 0xe5, 0x64, 0x53, 0x32, 0x6e, 0xbc, 0x17, 0x8e, 0x6d, 0x91,
    0x15, 0x46, 0x2e, 0x1a, 0xfd, 0x27, 0xe7, 0x16, 0x19, 0x09, 0x36, 0x5d, 0xf9,
    0x9b, 0xe5, 0x19, 0xa5, 0xba, 0xc0, 0xa0, 0x7f, 0xb2, 0x72, 0x91, 0x77, 0x04,
    0x0c, 0x87, 0xf9, 0xac, 0xb0, 0x3b, 0xe3, 0x5f, 0xf2, 0xcb, 0xaf, 0xf2, 0xc2,
    0x76, 0xd8, 0x20, 0xdb, 0x4d, 0x58, 0xfd, 0x39, 0x97,
  ])
  let n = @bigint.BigNat::from_bytes_be(n_bytes)
  let sig = @bigint.BigNat::from_bytes_be(sig_bytes)
  let e = @bigint.BigNat::from_bytes_be(
    FixedArray::from_array([0x01, 0x00, 0x01]),
  )
  // One-time context setup (n' via Newton, R^2 via repeated doubling).
  let k = n.limb64_len()
  let ctx = @bigint.MontCtx::new(n.to_limbs64(k), k)
  let mut i = 0
  let mut acc = @bigint.BigNat::from_uint64(0UL)
  while i < 50 {
    acc = @bigint.mont_pow_with(ctx, sig, e)
    i = i + 1
  }
  println(@bigint.BigNat::to_hex(acc))
}
