import {
  "moonbitlang/core/env",
  "openssh/openssh_moonbit/src/bigint",
  "openssh/openssh_moonbit/src/ecdsa",
  "openssh/openssh_moonbit/src/keyfile",
  "openssh/openssh_moonbit/src/knownhosts",
  "openssh/openssh_moonbit/src/scp",
  "openssh/openssh_moonbit/src/sftpdrive",
  "openssh/openssh_moonbit/src/sshclient",
  "openssh/openssh_moonbit/src/subproc",
  "openssh/openssh_moonbit/src/tcp",
}

pkgtype(kind: "executable")

///| Native only: this driver spawns a child process and writes raw bytes
/// to a file descriptor, neither of which a browser target can do.  The
/// library it drives (`src/scp`) still builds on all four targets -- that
/// is where the rules live and where the tests run.

options(
  supported_targets: "+native",
)
