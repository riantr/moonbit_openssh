import {
  "moonbitlang/core/env",
  "riantr/moonbit_openssh/src/bigint",
  "riantr/moonbit_openssh/src/ecdsa",
  "riantr/moonbit_openssh/src/keyfile",
  "riantr/moonbit_openssh/src/knownhosts",
  "riantr/moonbit_openssh/src/scp" @scplib,
  "riantr/moonbit_openssh/src/sftpdrive",
  "riantr/moonbit_openssh/src/sshclient",
  "riantr/moonbit_openssh/src/subproc",
  "riantr/moonbit_openssh/src/tcp",
}

pkgtype(kind: "executable")

///| Native only: this driver spawns a child process and writes raw bytes
/// to a file descriptor, neither of which a browser target can do.  The
/// library it drives (`src/scp`) still builds on all four targets -- that
/// is where the rules live and where the tests run.

options(
  supported_targets: "+native",
)
