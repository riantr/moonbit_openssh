import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "riantr/moonbit_openssh/src/wt",
  "riantr/moonbit_openssh/src/wtlive",
  "riantr/moonbit_openssh/src/bigint",
  "riantr/moonbit_openssh/src/ecdsa",
  "riantr/moonbit_openssh/src/sha256",
  "riantr/moonbit_openssh/src/sshclient",
  "riantr/moonbit_openssh/src/knownhosts",
  "riantr/moonbit_openssh/src/khstore",
  "riantr/moonbit_openssh/src/sftp",
}

///| Loop #32 G3 driver: js target only, runs inside a browser Web Worker.
///|
///| Both `main.mbt` and the `src/wt` / `src/wtlive` packages it pulls in use
///| `extern "js"` and async, neither of which the wasm backends support.
pkgtype(kind: "executable")

options(
  supported_targets: "+js",
)
