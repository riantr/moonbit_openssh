import {
  "moonbitlang/async",
  "moonbitlang/async/js_async",
  "openssh/openssh_moonbit/src/wt",
  "openssh/openssh_moonbit/src/wtlive",
  "openssh/openssh_moonbit/src/bigint",
  "openssh/openssh_moonbit/src/ecdsa",
  "openssh/openssh_moonbit/src/sha256",
  "openssh/openssh_moonbit/src/sshclient",
  "openssh/openssh_moonbit/src/knownhosts",
  "openssh/openssh_moonbit/src/khstore",
  "openssh/openssh_moonbit/src/sftp",
}

///| Loop #32 G3 driver: js target only, runs inside a browser Web Worker.
///|
///| Both `main.mbt` and the `src/wt` / `src/wtlive` packages it pulls in use
///| `extern "js"` and async, neither of which the wasm backends support.
pkgtype(kind: "executable")

options(
  targets: { "main.mbt": [ "js" ] },
)
