///| Loop #29 G1+G2 UInt128 + Montgomery CIOS (64-bit limbs) byte-exact KAT
///|
///| AUTO-GENERATED by scripts/gen_u128_kat.py -- do not hand-edit.
///| All vectors come from Python arbitrary-precision integers.

fn hex_pad(v : UInt64) -> String {
  let hex : String = "0123456789ABCDEF"
  let sb = StringBuilder()
  let mut shift = 60
  while shift >= 0 {
    let nib = (((v >> shift) & 0xFUL).to_uint()).reinterpret_as_int()
    sb.write_string(hex.unsafe_substring(start=nib, end=nib + 1))
    shift = shift - 4
  }
  sb.to_string()
}

///| Print a little-endian 64-bit limb array as trimmed big-endian hex.
fn print_limbs(label : String, l : FixedArray[UInt64], k : Int) -> Unit {
  let hex : String = "0123456789ABCDEF"
  let sb = StringBuilder()
  sb.write_string(label + ": ")
  let total = k * 16
  let buf : FixedArray[Int] = FixedArray::make(total, 0)
  let mut idx = 0
  let mut li = k - 1
  while li >= 0 {
    let word = l[li]
    let mut sh = 60
    while sh >= 0 {
      let nib = (((word >> sh) & 0xFUL).to_uint()).reinterpret_as_int()
      buf[idx] = nib
      idx = idx + 1
      sh = sh - 4
    }
    li = li - 1
  }
  let mut start = 0
  while start < total - 1 && buf[start] == 0 {
    start = start + 1
  }
  let mut i = start
  while i < total {
    sb.write_string(hex.unsafe_substring(start=buf[i], end=buf[i] + 1))
    i = i + 1
  }
  println(sb.to_string())
}

fn print_mul(a : UInt64, b : UInt64) -> Unit {
  let r = @bigint.mul_u64x64(a, b)
  println("mul " + hex_pad(a) + " " + hex_pad(b) + " -> " + hex_pad(r.hi) + " " + hex_pad(r.lo))
}

