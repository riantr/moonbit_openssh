///| Loop #33 byte-exact verification (cmd/ctrmac_test)
///
/// Verifies the aes128-ctr + hmac-sha2-256 encrypt-and-MAC packet layer added
/// to `src/bpacket` as `Mode::MacEncrypt`.
///
/// The vectors in `vectors.mbt` are generated by `host/gen_ctrmac_vectors.py`
/// from `host/ssh_ctrhmac_oracle.py`, which only emits them after checking its
/// own from-spec implementation against paramiko's `Packetizer`. So this file is
/// the third opinion, not the first -- it never hand-copies a constant that some
/// other implementation did not already agree on.
///
/// What is actually being checked, beyond the obvious "the bytes match":
///
///   * counter continuity -- each case emits N packets back to back, so an
///     implementation that re-seeds the CTR counter from the IV per packet
///     still passes packet 0 and fails from packet 1 on;
///   * block alignment -- every emitted frame is a multiple of 16 bytes, which
///     is the rule that silently changes when the mode switches from `none`
///     (block 8) to aes128-ctr (block 16);
///   * MAC placement -- the last 32 wire bytes are the MAC, and they cover the
///     plaintext frame, so a swapped order or a MAC over ciphertext fails here;
///   * tamper detection -- flipping one bit in the ciphertext or in the MAC must
///     be rejected, not silently accepted.

///|
/// hex 字符串 -> 字节
///
/// MoonBit 的 `String` 下标返回 `UInt16`(UTF-16 码元)而不是 `Char`,
/// 所以这里按 `UInt16` 收参,不要想当然写成 `Char`。
fn hex_nibble(c : UInt16) -> Int32 {
  let n = c.to_int()
  if n >= 48 && n <= 57 {
    return n - 48
  }
  if n >= 97 && n <= 102 {
    return n - 87
  }
  abort("hex_to_bytes: bad digit")
}

///|
fn hex_to_bytes(s : String) -> FixedArray[Byte] {
  let n = s.length() / 2
  let out : FixedArray[Byte] = FixedArray::make(n, b'\x00')
  let mut i = 0
  while i < n {
    let hi = hex_nibble(s[i * 2])
    let lo = hex_nibble(s[i * 2 + 1])
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn bytes_equal(a : FixedArray[Byte], b : FixedArray[Byte]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].to_int() != b[i].to_int() {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn cat(a : FixedArray[Byte], b : FixedArray[Byte]) -> FixedArray[Byte] {
  let out : FixedArray[Byte] = FixedArray::make(
    a.length() + b.length(),
    b'\x00',
  )
  for i = 0; i < a.length(); i = i + 1 {
    out[i] = a[i]
  }
  for i = 0; i < b.length(); i = i + 1 {
    out[a.length() + i] = b[i]
  }
  out
}

///|
fn byte_to_hex(b : Byte) -> String {
  let hex_chars : String = "0123456789abcdef"
  let hi = b.to_int() / 16
  let lo = b.to_int() % 16
  hex_chars.unsafe_substring(start=hi, end=hi + 1) +
  hex_chars.unsafe_substring(start=lo, end=lo + 1)
}

///|
fn to_hex(b : FixedArray[Byte]) -> String {
  let sb = StringBuilder()
  for i = 0; i < b.length(); i = i + 1 {
    sb.write_string(byte_to_hex(b[i]))
  }
  sb.to_string()
}

///|
fn pf(ok : Bool) -> String {
  if ok {
    "PASS"
  } else {
    "FAIL"
  }
}

///|
/// 是不是 MacInvalid
fn is_mac_invalid(ev : @bpacket.RecvEvent) -> Bool {
  match ev {
    @bpacket.Failed(@bpacket.MacInvalid) => true
    _ => false
  }
}

///|
fn main {
  let key = hex_to_bytes(KAT_KEY_HEX)
  let iv = hex_to_bytes(KAT_IV_HEX)
  let mac_key = hex_to_bytes(KAT_MAC_KEY_HEX)

  let mut emit_ok = true
  let mut recv_ok = true
  let mut stream_ok = true

  for c in kat_cases() {
    let payload = hex_to_bytes(c.payload_hex)
    let pad_src : FixedArray[Byte] = FixedArray::make(64, b'\x00')

    // ---- 发送方向:逐包比对 frame 与 wire ----
    let ctx = @bpacket.AesCtrMacCtx::new(key, iv, mac_key)
    let s = @bpacket.SendCtx::make(@bpacket.MacEncrypt(ctx), 0U, false, false)
    let mut produced : FixedArray[Byte] = FixedArray::make(0, b'\x00')
    let mut this_emit = true
    let mut i = 0
    while i < c.wires.length() {
      let want_frame = hex_to_bytes(c.frames[i])
      let want_wire = hex_to_bytes(c.wires[i])
      match s.emit(c.msg_type, payload, pad_src) {
        Ok(pkt) => {
          // frame 必须按 16 字节块对齐:这一条一旦破了,服务器只会回一句
          // "padding error: need N block 16 mod M",很难反推到组帧这一层。
          if pkt.frame.length() % 16 != 0 {
            this_emit = false
          }
          if !bytes_equal(pkt.frame, want_frame) {
            this_emit = false
          }
          if !bytes_equal(pkt.wire, want_wire) {
            this_emit = false
          }
          produced = cat(produced, pkt.wire)
        }
        _ => this_emit = false
      }
      i = i + 1
    }
    // 线上字节逐包重放,供 verify 脚本与 Python oracle 对拍
    println("ctr_mac_wire_" + c.name + ": " + to_hex(produced))
    if !this_emit {
      emit_ok = false
    }
    println("ctr_mac_emit_" + c.name + ": " + pf(this_emit))

    // ---- 接收方向:把整条流一次性喂进去,逐包解回 ----
    let rctx = @bpacket.AesCtrMacCtx::new(key, iv, mac_key)
    let r = @bpacket.RecvCtx::make(@bpacket.MacEncrypt(rctx), 0U, false, false)
    let mut off = 0
    let mut this_recv = true
    let mut got = 0
    while off < produced.length() {
      match r.recv(slice_from(produced, off)) {
        res => {
          match res.event {
            @bpacket.Packet(seq, t, pl) => {
              if seq != got.reinterpret_as_uint() || t != c.msg_type {
                this_recv = false
              }
              if !bytes_equal(pl, payload) {
                this_recv = false
              }
            }
            _ => this_recv = false
          }
          off = off + res.consumed
          got = got + 1
        }
      }
    }
    if got != c.wires.length() {
      this_recv = false
    }
    if !this_recv {
      recv_ok = false
    }
    println("ctr_mac_recv_" + c.name + ": " + pf(this_recv))

    // ---- 分片喂入:一字节一字节地攒,只有凑满才应解出整包 ----
    let rctx2 = @bpacket.AesCtrMacCtx::new(key, iv, mac_key)
    let r2 = @bpacket.RecvCtx::make(
      @bpacket.MacEncrypt(rctx2),
      0U,
      false,
      false,
    )
    let mut pref : FixedArray[Byte] = FixedArray::make(0, b'\x00')
    let mut p = 0
    let mut this_stream = true
    while p < produced.length() {
      pref = cat(pref, one_byte(produced[p]))
      let res = r2.recv(pref)
      let complete = match res.event {
        @bpacket.Packet(_, _, _) => true
        _ => false
      }
      if complete {
        if res.consumed != pref.length() {
          this_stream = false
        }
        // consumed 应恰好等于本包在流中的长度
        pref = FixedArray::make(0, b'\x00')
        // 未凑满时不得消费任何字节
      } else if res.consumed != 0 {
        this_stream = false
      }
      p = p + 1
    }
    if pref.length() != 0 {
      this_stream = false
    }
    if !this_stream {
      stream_ok = false
    }
    println("ctr_mac_stream_" + c.name + ": " + pf(this_stream))
  }

  println("ctr_mac_emit_all: " + pf(emit_ok))
  println("ctr_mac_recv_all: " + pf(recv_ok))
  println("ctr_mac_stream_all: " + pf(stream_ok))

  // ---- 篡改检测:一个比特都不许放过 ----
  let payload = hex_to_bytes(kat_cases()[0].payload_hex)
  let pad_src : FixedArray[Byte] = FixedArray::make(64, b'\x00')
  let ctx = @bpacket.AesCtrMacCtx::new(key, iv, mac_key)
  let s = @bpacket.SendCtx::make(@bpacket.MacEncrypt(ctx), 0U, false, false)
  let good = match s.emit(kat_cases()[0].msg_type, payload, pad_src) {
    Ok(p) => p.wire
    _ => abort("emit failed")
  }

  // 翻 MAC 里的一个比特
  let mac_flip : FixedArray[Byte] = array_copy(good)
  let last = mac_flip.length() - 1
  mac_flip[last] = mac_flip[last] ^ b'\x01'
  let r1 = @bpacket.RecvCtx::make(
    @bpacket.MacEncrypt(@bpacket.AesCtrMacCtx::new(key, iv, mac_key)),
    0U,
    false,
    false,
  )
  let mac_tamper_ok = is_mac_invalid(r1.recv(mac_flip).event)
  println("ctr_mac_tamper_mac: " + pf(mac_tamper_ok))

  // 翻密文里的一个比特:MAC 覆盖明文,所以解密后必然对不上
  let ct_flip : FixedArray[Byte] = array_copy(good)
  ct_flip[5] = ct_flip[5] ^ b'\x01'
  let r2 = @bpacket.RecvCtx::make(
    @bpacket.MacEncrypt(@bpacket.AesCtrMacCtx::new(key, iv, mac_key)),
    0U,
    false,
    false,
  )
  let ct_tamper_ok = is_mac_invalid(r2.recv(ct_flip).event)
  println("ctr_mac_tamper_ciphertext: " + pf(ct_tamper_ok))

  // 翻 padlen 字节(位于密文里,偏移 4)
  let pad_flip : FixedArray[Byte] = array_copy(good)
  pad_flip[4] = pad_flip[4] ^ b'\x01'
  let r3 = @bpacket.RecvCtx::make(
    @bpacket.MacEncrypt(@bpacket.AesCtrMacCtx::new(key, iv, mac_key)),
    0U,
    false,
    false,
  )
  let pad_tamper_ok = is_mac_invalid(r3.recv(pad_flip).event)
  println("ctr_mac_tamper_padlen: " + pf(pad_tamper_ok))

  println(
    "ctr_mac_tamper_all: " + pf(mac_tamper_ok && ct_tamper_ok && pad_tamper_ok),
  )
}

///|
fn array_copy(a : FixedArray[Byte]) -> FixedArray[Byte] {
  let out : FixedArray[Byte] = FixedArray::make(a.length(), b'\x00')
  for i = 0; i < a.length(); i = i + 1 {
    out[i] = a[i]
  }
  out
}

///|
fn one_byte(b : Byte) -> FixedArray[Byte] {
  let out : FixedArray[Byte] = FixedArray::make(1, b)
  out[0] = b
  out
}

///|
/// 造一个 buf[off..] 的视图(RecvCtx 消费的是「从包首开始的连续字节」)
fn slice_from(buf : FixedArray[Byte], off : Int32) -> FixedArray[Byte] {
  let n = buf.length() - off
  let out : FixedArray[Byte] = FixedArray::make(n, b'\x00')
  for i = 0; i < n; i = i + 1 {
    out[i] = buf[off + i]
  }
  out
}
