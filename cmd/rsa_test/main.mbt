///|
/// Loop #27 G3 RSA host key verify byte-exact (PKCS#1 v1.5 + SHA-256)
fn main {
  // ============ RSA-512 test vector (signed "hello" with SHA-256) ============
  let n_bytes : FixedArray[Byte] = FixedArray::from_array([
    0xA1, 0x7A, 0x80, 0xEE, 0x50, 0x68, 0xB0, 0xA0, 0xE6, 0xB6, 0x8E, 0x5F, 0x89,
    0xFB, 0xB9, 0xB5, 0x58, 0xEC, 0x5F, 0x0C, 0x82, 0x67, 0x8E, 0x38, 0xB7, 0x7B,
    0x10, 0xA1, 0x1C, 0xC4, 0x9F, 0x49, 0x86, 0xB2, 0x24, 0x73, 0x38, 0xB6, 0x3A,
    0xF0, 0xB6, 0xEB, 0x6A, 0xBF, 0x46, 0xC1, 0xD4, 0x2D, 0x37, 0x85, 0x2D, 0xEC,
    0x94, 0xC8, 0x0F, 0xB3, 0x38, 0x1E, 0xE7, 0x85, 0x1C, 0x30, 0x84, 0xF3,
  ])
  let e_bytes : FixedArray[Byte] = FixedArray::from_array([0x01, 0x00, 0x01])
  let sig_bytes : FixedArray[Byte] = FixedArray::from_array([
    0x3B, 0x63, 0x21, 0xB3, 0xAD, 0x04, 0xFB, 0xD6, 0x20, 0x8F, 0xF3, 0xD8, 0x19,
    0x54, 0xA2, 0x5A, 0xF5, 0xC4, 0x0E, 0x11, 0xA7, 0xDE, 0x9F, 0x9E, 0x8C, 0x9B,
    0x62, 0x20, 0xA4, 0x0D, 0x44, 0xFD, 0xBC, 0xBA, 0xB3, 0xE4, 0x9C, 0x27, 0x3D,
    0xA7, 0xC1, 0x81, 0x28, 0x81, 0x89, 0xAE, 0x0C, 0x59, 0xD7, 0x62, 0xD4, 0x81,
    0x1A, 0x84, 0x40, 0xB0, 0x02, 0x94, 0x04, 0xB3, 0xFF, 0xBF, 0x44, 0xD1,
  ])
  // p, q, d for sign test
  let p_bytes : FixedArray[Byte] = FixedArray::from_array([
    0xD3, 0x82, 0xCF, 0x0F, 0xC4, 0x59, 0x97, 0x23, 0xCD, 0x83, 0x13, 0x3C, 0xF0,
    0x00, 0x76, 0x75, 0xE8, 0x6C, 0xB4, 0xE1, 0x6F, 0xE2, 0xE0, 0x07, 0x0D, 0xE9,
    0x97, 0x01, 0x57, 0x7F, 0x70, 0x01,
  ])
  let q_bytes : FixedArray[Byte] = FixedArray::from_array([
    0xC3, 0x71, 0x9B, 0x7D, 0x84, 0xB5, 0x29, 0x4C, 0xA3, 0x0F, 0xFF, 0x6E, 0xBB,
    0xC3, 0xEC, 0x6B, 0x4E, 0xBF, 0x97, 0x68, 0xCB, 0x28, 0x65, 0x0E, 0x1F, 0x38,
    0xE1, 0x6D, 0x3B, 0x79, 0x34, 0xF3,
  ])
  let d_bytes : FixedArray[Byte] = FixedArray::from_array([
    0x49, 0x0C, 0xF2, 0x66, 0xDD, 0x59, 0x7F, 0x0E, 0x4B, 0x51, 0x2A, 0xF7, 0x6D,
    0xA4, 0xC3, 0x4E, 0x96, 0xFB, 0xD7, 0xC4, 0x00, 0xFA, 0x78, 0x0C, 0x90, 0x74,
    0xCC, 0x01, 0x16, 0xD2, 0x9C, 0x7C, 0x1E, 0xA8, 0xE6, 0x00, 0x6F, 0x7A, 0x84,
    0xA0, 0xA3, 0x32, 0x34, 0x26, 0x2A, 0x67, 0x9D, 0x69, 0x94, 0x7E, 0xA1, 0x14,
    0xA1, 0x24, 0x17, 0x45, 0x88, 0x12, 0xCA, 0xEE, 0x97, 0x05, 0x00, 0x01,
  ])

  let n = @bigint.BigNat::from_bytes_be(n_bytes)
  let e = @bigint.BigNat::from_bytes_be(e_bytes)
  let d = @bigint.BigNat::from_bytes_be(d_bytes)

  let msg : FixedArray[Byte] = FixedArray::from_array([
    0x68, 0x65, 0x6C, 0x6C, 0x6F,
  ])

  // ============ G1 verify signature ============
  let valid = @rsa.rsa_verify_pkcs1_sha256(n, e, sig_bytes, msg)
  let valid_str = if valid { "PASS" } else { "FAIL" }
  println("rsa_verify: " + valid_str)

  // ============ G2 sign + verify roundtrip ============
  let sig2 = @rsa.rsa_sign_pkcs1_sha256(n, d, msg)
  let sig2_len = sig2.length().to_string()
  println("sig2_len: " + sig2_len)
  let sig2_first8 = {
    let sb = StringBuilder()
    let hex_chars : String = "0123456789abcdef"
    let mut k = 0
    while k < 16 && k < sig2.length() {
      let b = sig2[k].to_int()
      sb.write_string(hex_chars.unsafe_substring(start=b / 16, end=b / 16 + 1))
      sb.write_string(hex_chars.unsafe_substring(start=b % 16, end=b % 16 + 1))
      k = k + 1
    }
    sb.to_string()
  }
  println("sig2_first8: " + sig2_first8)

  // Verify the new signature
  let valid2 = @rsa.rsa_verify_pkcs1_sha256(n, e, sig2, msg)
  let valid2_str = if valid2 { "PASS" } else { "FAIL" }
  println("rsa_verify_after_sign: " + valid2_str)

  // ============ G3 wrong message should fail ============
  let bad_msg : FixedArray[Byte] = FixedArray::from_array([
    0x68, 0x65, 0x6C, 0x6C, 0x70,
  ])
  let valid3 = @rsa.rsa_verify_pkcs1_sha256(n, e, sig_bytes, bad_msg)
  let valid3_str = if valid3 { "WRONG_PASS" } else { "CORRECT_FAIL" }
  println("rsa_wrong_msg_reject: " + valid3_str)

  ignore(p_bytes)
  ignore(q_bytes)
}
