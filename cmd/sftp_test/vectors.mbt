///| GENERATED FILE -- do not edit by hand.
///| Regenerate with: python host/gen_sftp_vectors.py --capture .loop39/capture.json
///
/// Every inbound payload here is a real OpenSSH 8.0p1 `internal-sftp`
/// reply recorded by `host/sftp_capture.py`, with one exception stated
/// below.  The requests are what `src/sftp` must emit, derived from
/// `host/sftp_oracle.py` -- an independent implementation -- and
/// cross-checked against the requests paramiko actually framed in the
/// same session.
///
/// The one rewrite: a captured reply's 4-byte request id is replaced,
/// because ids are chosen by the client and pinning our numbering to
/// paramiko's would test the wrong thing.  Attribute blocks, extension
/// pairs, longnames and DATA payloads are verbatim.
///
/// `chunks` are CHANNEL_DATA payloads.  Their boundaries are chosen to
/// be hostile on purpose -- see each case's `note`.

pub(all) struct Op {
  kind : Int
  path : String
  ///| the second path of a rename; empty when the op has none
  path2 : String
  ///| the payload of a writefile, as hex
  payload : String
  ///| attribute fields.  -1 means *not mentioned*, which is a
  ///| different request from mentioning it with the value 0.
  perms : Int
  atime : Int
  mtime : Int
}

pub(all) struct Case {
  name : String
  ops : Array[Op]
  chunks : Array[String]
  requests : Array[String]
  results : Array[String]
  expect_done : Bool
  expect_failed : Bool
  note : String
}

