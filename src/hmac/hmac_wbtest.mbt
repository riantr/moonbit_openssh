///| HMAC-SHA256 RFC 4231 KAT 测试

///| 来源:RFC 4231 § 4 Test Case 1-7

///|
/// 字符串字面量转 FixedArray[Byte]
fn str_to_bytes(s : String) -> FixedArray[Byte] {
  let arr : FixedArray[Byte] = FixedArray::make(s.length(), b'\x00')
  for i = 0; i < s.length(); i = i + 1 {
    arr[i] = s[i].to_byte()
  }
  arr
}

///|
test "rfc4231_test_1_hi_there" {
  // Test 1: key=0x0b*20, data="Hi There"
  // expected: b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7
  let key : FixedArray[Byte] = FixedArray::make(20, 0x0b)
  let msg = str_to_bytes("Hi There")
  let expected : FixedArray[Byte] = [
    0xb0, 0x34, 0x4c, 0x61, 0xd8, 0xdb, 0x38, 0x53, 0x5c, 0xa8, 0xaf, 0xce, 0xaf,
    0x0b, 0xf1, 0x2b, 0x88, 0x1d, 0xc2, 0x00, 0xc9, 0x83, 0x3d, 0xa7, 0x26, 0xe9,
    0x37, 0x6c, 0x2e, 0x32, 0xcf, 0xf7,
  ]
  let tag = hmac_sha256(key, msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc4231_test_2_jefe" {
  // Test 2: key="Jefe", data="what do ya want for nothing?"
  // expected: 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
  let key = str_to_bytes("Jefe")
  let msg = str_to_bytes("what do ya want for nothing?")
  let expected : FixedArray[Byte] = [
    0x5b, 0xdc, 0xc1, 0x46, 0xbf, 0x60, 0x75, 0x4e, 0x6a, 0x04, 0x24, 0x26, 0x08,
    0x95, 0x75, 0xc7, 0x5a, 0x00, 0x3f, 0x08, 0x9d, 0x27, 0x39, 0x83, 0x9d, 0xec,
    0x58, 0xb9, 0x64, 0xec, 0x38, 0x43,
  ]
  let tag = hmac_sha256(key, msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc4231_test_3_aa_dd" {
  // Test 3: key=0xaa*20, data=0xdd*50
  // expected: 773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe
  let key : FixedArray[Byte] = FixedArray::make(20, 0xAA)
  let msg : FixedArray[Byte] = FixedArray::make(50, 0xDD)
  let expected : FixedArray[Byte] = [
    0x77, 0x3e, 0xa9, 0x1e, 0x36, 0x80, 0x0e, 0x46, 0x85, 0x4d, 0xb8, 0xeb, 0xd0,
    0x91, 0x81, 0xa7, 0x29, 0x59, 0x09, 0x8b, 0x3e, 0xf8, 0xc1, 0x22, 0xd9, 0x63,
    0x55, 0x14, 0xce, 0xd5, 0x65, 0xfe,
  ]
  let tag = hmac_sha256(key, msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc4231_test_4_25byte_key" {
  // Test 4: key=01 02 03 ... 19 (25 bytes), data=0xcd*50
  // expected: 82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b
  let key : FixedArray[Byte] = [
    0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d,
    0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19,
  ]
  let msg : FixedArray[Byte] = FixedArray::make(50, 0xCD)
  let expected : FixedArray[Byte] = [
    0x82, 0x55, 0x8a, 0x38, 0x9a, 0x44, 0x3c, 0x0e, 0xa4, 0xcc, 0x81, 0x98, 0x99,
    0xf2, 0x08, 0x3a, 0x85, 0xf0, 0xfa, 0xa3, 0xe5, 0x78, 0xf8, 0x07, 0x7a, 0x2e,
    0x3f, 0xf4, 0x67, 0x29, 0x66, 0x5b,
  ]
  let tag = hmac_sha256(key, msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc4231_test_5_truncation" {
  // Test 5: key=0x0c*20, data="Test With Truncation"
  // expected (truncated to 128 bits): a3b6167473100ee06e0c796c2955552b
  let key : FixedArray[Byte] = FixedArray::make(20, 0x0c)
  let msg = str_to_bytes("Test With Truncation")
  let expected_full : FixedArray[Byte] = [
    0xa3, 0xb6, 0x16, 0x74, 0x73, 0x10, 0x0e, 0xe0, 0x6e, 0x0c, 0x79, 0x6c, 0x29,
    0x55, 0x55, 0x2b, 0xfa, 0x04, 0x44, 0xaa, 0x9e, 0x82, 0x64, 0x91, 0xe6, 0x6c,
    0xed, 0x4c, 0x33, 0x3e, 0xe9, 0x10,
  ]
  let tag = hmac_sha256(key, msg)
  // 验证前 16 字节(截断到 128 bit)
  for i = 0; i < 16; i = i + 1 {
    assert_eq(tag[i], expected_full[i])
  }
}

///|
test "rfc4231_test_6_long_key" {
  // Test 6: key=0xaa*131, data="Test Using Larger Than Block-Size Key - Hash Key First"
  // expected: 60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54
  let key : FixedArray[Byte] = FixedArray::make(131, 0xAA)
  let msg = str_to_bytes(
    "Test Using Larger Than Block-Size Key - Hash Key First",
  )
  let expected : FixedArray[Byte] = [
    0x60, 0xe4, 0x31, 0x59, 0x1e, 0xe0, 0xb6, 0x7f, 0x0d, 0x8a, 0x26, 0xaa, 0xcb,
    0xf5, 0xb7, 0x7f, 0x8e, 0x0b, 0xc6, 0x21, 0x37, 0x28, 0xc5, 0x14, 0x05, 0x46,
    0x04, 0x0f, 0x0e, 0xe3, 0x7f, 0x54,
  ]
  let tag = hmac_sha256(key, msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc4231_test_7_long_key_and_data" {
  // Test 7: key=0xaa*131, data=152 字节
  // expected: 9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2
  let key : FixedArray[Byte] = FixedArray::make(131, 0xAA)
  let msg = str_to_bytes(
    "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.",
  )
  let expected : FixedArray[Byte] = [
    0x9b, 0x09, 0xff, 0xa7, 0x1b, 0x94, 0x2f, 0xcb, 0x27, 0x63, 0x5f, 0xbc, 0xd5,
    0xb0, 0xe9, 0x44, 0xbf, 0xdc, 0x63, 0x64, 0x4f, 0x07, 0x13, 0x93, 0x8a, 0x7f,
    0x51, 0x53, 0x5c, 0x3a, 0x35, 0xe2,
  ]
  let tag = hmac_sha256(key, msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}
