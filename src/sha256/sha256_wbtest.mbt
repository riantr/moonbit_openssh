///| SHA-256 RFC 7539 KAT 测试

///|
/// 来源:FIPS 180-4 Appendix B.1 + NIST CSRC 短测试向量
test "fips_180_4_test_1_abc" {
  // Test 1: "abc" → ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
  let msg : FixedArray[Byte] = [
    0x61, 0x62, 0x63, // "abc"
  ]
  let expected : FixedArray[Byte] = [
    0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d,
    0xae, 0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10,
    0xff, 0x61, 0xf2, 0x00, 0x15, 0xad,
  ]
  let h = sha256(msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(h[i], expected[i])
  }
}

///|
test "fips_180_4_test_2_million_a" {
  // Test 2: 1,000,000 × "a"
  // cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0
  let msg : FixedArray[Byte] = FixedArray::make(1000000, 0x61)
  let expected : FixedArray[Byte] = [
    0xcd, 0xc7, 0x6e, 0x5c, 0x99, 0x14, 0xfb, 0x92, 0x81, 0xa1, 0xc7, 0xe2, 0x84,
    0xd7, 0x3e, 0x67, 0xf1, 0x80, 0x9a, 0x48, 0xa4, 0x97, 0x20, 0x0e, 0x04, 0x6d,
    0x39, 0xcc, 0xc7, 0x11, 0x2c, 0xd0,
  ]
  let h = sha256(msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(h[i], expected[i])
  }
}

///|
test "fips_180_4_test_3_56bytes" {
  // Test 3: "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" (56 bytes)
  // 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
  let msg : FixedArray[Byte] = [
    0x61, 0x62, 0x63, 0x64, 0x62, 0x63, 0x64, 0x65, 0x63, 0x64, 0x65, 0x66, 0x64,
    0x65, 0x66, 0x67, 0x65, 0x66, 0x67, 0x68, 0x66, 0x67, 0x68, 0x69, 0x67, 0x68,
    0x69, 0x6a, 0x68, 0x69, 0x6a, 0x6b, 0x69, 0x6a, 0x6b, 0x6c, 0x6a, 0x6b, 0x6c,
    0x6d, 0x6b, 0x6c, 0x6d, 0x6e, 0x6c, 0x6d, 0x6e, 0x6f, 0x6d, 0x6e, 0x6f, 0x70,
    0x6e, 0x6f, 0x70, 0x71,
  ]
  let expected : FixedArray[Byte] = [
    0x24, 0x8d, 0x6a, 0x61, 0xd2, 0x06, 0x38, 0xb8, 0xe5, 0xc0, 0x26, 0x93, 0x0c,
    0x3e, 0x60, 0x39, 0xa3, 0x3c, 0xe4, 0x59, 0x64, 0xff, 0x21, 0x67, 0xf6, 0xec,
    0xed, 0xd4, 0x19, 0xdb, 0x06, 0xc1,
  ]
  let h = sha256(msg)
  for i = 0; i < 32; i = i + 1 {
    assert_eq(h[i], expected[i])
  }
}
