///| Poly1305 RFC 7539 § A.3 已知答案测试(KAT)

///| 来源:RFC 7539 Appendix A.3

///| 4 个标准测试向量 + 7 个边界向量(V#5-#11)

///|
/// 注意:tag 长度均为 16 字节
test "rfc7539_vector_1_all_zero" {
  // Vector #1: 全 0
  // key = 0 (32 字节), msg = 0 (64 字节), tag = 0 (16 字节)
  let key : FixedArray[Byte] = FixedArray::make(32, 0x00)
  let msg : FixedArray[Byte] = FixedArray::make(64, 0x00)
  let expected : FixedArray[Byte] = FixedArray::make(16, 0x00)
  let tag = poly1305_auth(key, msg)
  for i = 0; i < 16; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc7539_vector_2_r_zero" {
  // Vector #2: r = 0, s 非零
  // 因为 r=0, h*r ≡ 0,所以 tag = s = key[16..32]
  // msg 是 375 字节的 IETF 文档(RFC 7539 A.3)
  let key : FixedArray[Byte] = FixedArray::make(32, 0x00)
  let s_bytes : FixedArray[Byte] = [
    0x36, 0xe5, 0xf6, 0xb5, 0xc5, 0xe0, 0x60, 0x70, 0xf0, 0xef, 0xca, 0x96, 0x22,
    0x7a, 0x86, 0x3e,
  ]
  for i = 0; i < 16; i = i + 1 {
    key[16 + i] = s_bytes[i]
  }
  // IETF 提交文本,375 字节(RFC 7539 § A.3 Vector #2)
  let msg : FixedArray[Byte] = [
    0x41, 0x6e, 0x79, 0x20, 0x73, 0x75, 0x62, 0x6d, 0x69, 0x73, 0x73, 0x69, 0x6f,
    0x6e, 0x20, 0x74, // "Any submission t"
     0x6f, 0x20, 0x74, 0x68, 0x65, 0x20, 0x49, 0x45, 0x54, 0x46, 0x20, 0x69, 0x6e,
    0x74, 0x65, 0x6e, // "o the IETF inten"
     0x64, 0x65, 0x64, 0x20, 0x62, 0x79, 0x20, 0x74, 0x68, 0x65, 0x20, 0x43, 0x6f,
    0x6e, 0x74, 0x72, // "ded by the Contr"
     0x69, 0x62, 0x75, 0x74, 0x6f, 0x72, 0x20, 0x66, 0x6f, 0x72, 0x20, 0x70, 0x75,
    0x62, 0x6c, 0x69, // "ibutor for publi"
     0x63, 0x61, 0x74, 0x69, 0x6f, 0x6e, 0x20, 0x61, 0x73, 0x20, 0x61, 0x6c, 0x6c,
    0x20, 0x6f, 0x72, // "cation as all or"
     0x20, 0x70, 0x61, 0x72, 0x74, 0x20, 0x6f, 0x66, 0x20, 0x61, 0x6e, 0x20, 0x49,
    0x45, 0x54, 0x46, // " part of an IETF"
     0x20, 0x49, 0x6e, 0x74, 0x65, 0x72, 0x6e, 0x65, 0x74, 0x2d, 0x44, 0x72, 0x61,
    0x66, 0x74, 0x20, // " Internet-Draft "
     0x6f, 0x72, 0x20, 0x52, 0x46, 0x43, 0x20, 0x61, 0x6e, 0x64, 0x20, 0x61, 0x6e,
    0x79, 0x20, 0x73, // "or RFC and any s"
     0x74, 0x61, 0x74, 0x65, 0x6d, 0x65, 0x6e, 0x74, 0x20, 0x6d, 0x61, 0x64, 0x65,
    0x20, 0x77, 0x69, // "tatement made wi"
     0x74, 0x68, 0x69, 0x6e, 0x20, 0x74, 0x68, 0x65, 0x20, 0x63, 0x6f, 0x6e, 0x74,
    0x65, 0x78, 0x74, // "thin the context"
     0x20, 0x6f, 0x66, 0x20, 0x61, 0x6e, 0x20, 0x49, 0x45, 0x54, 0x46, 0x20, 0x61,
    0x63, 0x74, 0x69, // " of an IETF acti"
     0x76, 0x69, 0x74, 0x79, 0x20, 0x69, 0x73, 0x20, 0x63, 0x6f, 0x6e, 0x73, 0x69,
    0x64, 0x65, 0x72, // "vity is consider"
     0x65, 0x64, 0x20, 0x61, 0x6e, 0x20, 0x22, 0x49, 0x45, 0x54, 0x46, 0x20, 0x43,
    0x6f, 0x6e, 0x74, // "ed an "IETF Cont"
     0x72, 0x69, 0x62, 0x75, 0x74, 0x69, 0x6f, 0x6e, 0x22, 0x2e, 0x20, 0x53, 0x75,
    0x63, 0x68, 0x20, // "ribution". Such "
     0x73, 0x74, 0x61, 0x74, 0x65, 0x6d, 0x65, 0x6e, 0x74, 0x73, 0x20, 0x69, 0x6e,
    0x63, 0x6c, 0x75, // "statements inclu"
     0x64, 0x65, 0x20, 0x6f, 0x72, 0x61, 0x6c, 0x20, 0x73, 0x74, 0x61, 0x74, 0x65,
    0x6d, 0x65, 0x6e, // "de oral statemen"
     0x74, 0x73, 0x20, 0x69, 0x6e, 0x20, 0x49, 0x45, 0x54, 0x46, 0x20, 0x73, 0x65,
    0x73, 0x73, 0x69, // "ts in IETF sessi"
     0x6f, 0x6e, 0x73, 0x2c, 0x20, 0x61, 0x73, 0x20, 0x77, 0x65, 0x6c, 0x6c, 0x20,
    0x61, 0x73, 0x20, // "ons, as well as "
     0x77, 0x72, 0x69, 0x74, 0x74, 0x65, 0x6e, 0x20, 0x61, 0x6e, 0x64, 0x20, 0x65,
    0x6c, 0x65, 0x63, // "written and elec"
     0x74, 0x72, 0x6f, 0x6e, 0x69, 0x63, 0x20, 0x63, 0x6f, 0x6d, 0x6d, 0x75, 0x6e,
    0x69, 0x63, 0x61, // "tronic communica"
     0x74, 0x69, 0x6f, 0x6e, 0x73, 0x20, 0x6d, 0x61, 0x64, 0x65, 0x20, 0x61, 0x74,
    0x20, 0x61, 0x6e, // "tions made at an"
     0x79, 0x20, 0x74, 0x69, 0x6d, 0x65, 0x20, 0x6f, 0x72, 0x20, 0x70, 0x6c, 0x61,
    0x63, 0x65, 0x2c, // "y time or place,"
     0x20, 0x77, 0x68, 0x69, 0x63, 0x68, 0x20, 0x61, 0x72, 0x65, 0x20, 0x61, 0x64,
    0x64, 0x72, 0x65, // " which are addre"
     0x73, 0x73, 0x65, 0x64, 0x20, 0x74, 0x6f, // "ssed to"
  ]
  let expected : FixedArray[Byte] = [
    0x36, 0xe5, 0xf6, 0xb5, 0xc5, 0xe0, 0x60, 0x70, 0xf0, 0xef, 0xca, 0x96, 0x22,
    0x7a, 0x86, 0x3e,
  ]
  let tag = poly1305_auth(key, msg)
  for i = 0; i < 16; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

