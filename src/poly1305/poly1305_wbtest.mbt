///|
test "rfc7539_vector_4_jabberwocky" {
  // Vector #4: 完整 120 字节 Jabberwocky 文本(RFC 7539 § A.3)
  // tag: 45 41 66 9a 7e aa ee 61 e7 08 dc 7c bc c5 eb 62
  let key : FixedArray[Byte] = [
    0x1c, 0x92, 0x40, 0xa5, 0xeb, 0x55, 0xd3, 0x8a, 0xf3, 0x33, 0x88, 0x86, 0x04,
    0xf6, 0xb5, 0xf0, 0x47, 0x39, 0x17, 0xc1, 0x40, 0x2b, 0x80, 0x09, 0x9d, 0xca,
    0x5c, 0xbc, 0x20, 0x70, 0x75, 0xc0,
  ]
  // Jabberwocky 120 字节,7 行 16 字节 + 1 行 8 字节
  // 来源:RFC 7539 § A.3
  let msg : FixedArray[Byte] = [
    0x27, 0x54, 0x77, 0x61, 0x73, 0x20, 0x62, 0x72, 0x69, 0x6c, 0x6c, 0x69, 0x67,
    0x2c, 0x20, 0x61, // 'Twas brillig, a
     0x6e, 0x64, 0x20, 0x74, 0x68, 0x65, 0x20, 0x73, 0x6c, 0x69, 0x74, 0x68, 0x79,
    0x20, 0x74, 0x6f, // nd the slithy to
     0x76, 0x65, 0x73, 0x0a, 0x44, 0x69, 0x64, 0x20, 0x67, 0x79, 0x72, 0x65, 0x20,
    0x61, 0x6e, 0x64, // ves.Did gyre and
     0x20, 0x67, 0x69, 0x6d, 0x62, 0x6c, 0x65, 0x20, 0x69, 0x6e, 0x20, 0x74, 0x68,
    0x65, 0x20, 0x77, //  gimble in the w
     0x61, 0x62, 0x65, 0x3a, 0x0a, 0x41, 0x6c, 0x6c, 0x20, 0x6d, 0x69, 0x6d, 0x73,
    0x79, 0x20, 0x77, // abe:.All mimsy w
     0x65, 0x72, 0x65, 0x20, 0x74, 0x68, 0x65, 0x20, 0x62, 0x6f, 0x72, 0x6f, 0x67,
    0x6f, 0x76, 0x65, // ere the borogove
     0x73, 0x2c, 0x0a, 0x41, 0x6e, 0x64, 0x20, 0x74, 0x68, 0x65, 0x20, 0x6d, 0x6f,
    0x6d, 0x65, 0x20, // s,.And the mome
     0x72, 0x61, 0x74, 0x68, 0x73, 0x20, 0x6f, 0x75, 0x74, 0x67, 0x72, 0x61, 0x62,
    0x65, 0x2e, // raths outgrabe.
  ]
  let expected : FixedArray[Byte] = [
    0x45, 0x41, 0x66, 0x9a, 0x7e, 0xaa, 0xee, 0x61, 0xe7, 0x08, 0xdc, 0x7c, 0xbc,
    0xc5, 0xeb, 0x62,
  ]
  let tag = poly1305_auth(key, msg)
  for i = 0; i < 16; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc7539_vector_5_partial_reduction" {
  // Vector #5: 测试 130-bit partial reduction
  // R = 0x02..., S = 0, msg = 0xFF...FF (16 字节)
  // tag = 0x03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  let key : FixedArray[Byte] = [
    0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ]
  let msg : FixedArray[Byte] = [
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff,
  ]
  let expected : FixedArray[Byte] = [
    0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
  ]
  let tag = poly1305_auth(key, msg)
  for i = 0; i < 16; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc7539_vector_6_s_overflow" {
  // Vector #6: 测试 s 加法溢出 2^128
  // R = 0x02..., S = 0xFF...FF, msg = 0x02 0x00 0x00 00...
  // tag = 0x03 00 00 00 ...(因为 add s 不应 mod 2^128,wrap 后正好是 0x03)
  let key : FixedArray[Byte] = [
    0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  ]
  let msg : FixedArray[Byte] = [
    0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
  ]
  let expected : FixedArray[Byte] = [
    0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
  ]
  let tag = poly1305_auth(key, msg)
  for i = 0; i < 16; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc7539_vector_7_carry_from_lower_limb" {
  // Vector #7: 全 1 数据 + carry
  // R = 0x01, S = 0
  // msg = FF...FF(16) + F0 FF...FF(16) + 11 00...(16)
  // tag = 0x05 00 00 ...
  let key : FixedArray[Byte] = [
    0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ]
  let msg : FixedArray[Byte] = [
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xf0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ]
  let expected : FixedArray[Byte] = [
    0x05, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
  ]
  let tag = poly1305_auth(key, msg)
  for i = 0; i < 16; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

///|
test "rfc7539_vector_8_final_eq_p" {
  // Vector #8: final polynomial result 正好等于 2^130-5
  // 应该归约到 0
  let key : FixedArray[Byte] = [
    0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ]
  let msg : FixedArray[Byte] = [
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xfb, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe,
    0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
  ]
  let expected : FixedArray[Byte] = [
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
  ]
  let tag = poly1305_auth(key, msg)
  for i = 0; i < 16; i = i + 1 {
    assert_eq(tag[i], expected[i])
  }
}

