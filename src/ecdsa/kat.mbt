///| ECDSA KAT vector accessors (Loop #30 G4)
///

///| Thin typed wrappers over the generated byte arrays in `kat_data.mbt`, so

///| the test driver reads as ordinary code instead of byte-array plumbing.

///|
/// RFC 6979 test message.
pub fn kat_msg() -> FixedArray[Byte] {
  data_msg
}

///|
/// Tampered message (one byte differs).
pub fn kat_bad_msg() -> FixedArray[Byte] {
  data_bad_msg
}

///|
/// Private key d for vector `i` of the named curve.
pub fn load_kat_priv(name : String, i : Int32) -> @bigint.BigNat {
  let v = match (name, i) {
    ("p256", 0) => p256_d0
    ("p256", 1) => p256_d1
    ("p256", _) => p256_d2
    ("p384", 0) => p384_d0
    ("p384", 1) => p384_d1
    (_, _) => p384_d2
  }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// Public key x for vector `i`.
pub fn load_kat_Qx(name : String, i : Int32) -> @bigint.BigNat {
  let v = match (name, i) {
    ("p256", 0) => p256_Qx0
    ("p256", 1) => p256_Qx1
    ("p256", _) => p256_Qx2
    ("p384", 0) => p384_Qx0
    ("p384", 1) => p384_Qx1
    (_, _) => p384_Qx2
  }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// Public key y for vector `i`.
pub fn load_kat_Qy(name : String, i : Int32) -> @bigint.BigNat {
  let v = match (name, i) {
    ("p256", 0) => p256_Qy0
    ("p256", 1) => p256_Qy1
    ("p256", _) => p256_Qy2
    ("p384", 0) => p384_Qy0
    ("p384", 1) => p384_Qy1
    (_, _) => p384_Qy2
  }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// Reference r for vector `i`.
pub fn load_kat_r(name : String, i : Int32) -> @bigint.BigNat {
  let v = match (name, i) {
    ("p256", 0) => p256_r0
    ("p256", 1) => p256_r1
    ("p256", _) => p256_r2
    ("p384", 0) => p384_r0
    ("p384", 1) => p384_r1
    (_, _) => p384_r2
  }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// Reference s for vector `i`.
pub fn load_kat_s(name : String, i : Int32) -> @bigint.BigNat {
  let v = match (name, i) {
    ("p256", 0) => p256_s0
    ("p256", 1) => p256_s1
    ("p256", _) => p256_s2
    ("p384", 0) => p384_s0
    ("p384", 1) => p384_s1
    (_, _) => p384_s2
  }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// RFC 6979 reference nonce k for vector `i`.
pub fn load_kat_k(name : String, i : Int32) -> @bigint.BigNat {
  let v = match (name, i) {
    ("p256", 0) => p256_k0
    ("p256", 1) => p256_k1
    ("p256", _) => p256_k2
    ("p384", 0) => p384_k0
    ("p384", 1) => p384_k1
    (_, _) => p384_k2
  }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// Tampered r = reference_r + 1 (mod n).
pub fn load_kat_bad_r(name : String) -> @bigint.BigNat {
  let v = if name == "p256" { p256_bad_r } else { p384_bad_r }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// r = 0 (must be rejected).
pub fn load_kat_zero_r(name : String) -> @bigint.BigNat {
  let v = if name == "p256" { p256_zero_r } else { p384_zero_r }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// s = 0 (must be rejected).
pub fn load_kat_zero_s(name : String) -> @bigint.BigNat {
  let v = if name == "p256" { p256_zero_s } else { p384_zero_s }
  @bigint.BigNat::from_bytes_be(v)
}

///|
/// s = n (out of range, must be rejected).
pub fn load_kat_big_s(name : String) -> @bigint.BigNat {
  let v = if name == "p256" { p256_big_s } else { p384_big_s }
  @bigint.BigNat::from_bytes_be(v)
}
