///| SHA-512 RFC KAT 测试

///|
/// 来源:FIPS 180-4 § A.2 (Test 1 + 2 + 3) + Python hashlib cross-check
test "fips_180_4_test_1_abc" {
  // FIPS 180-4 § A.2 Test 1: "abc"
  // Python hashlib.sha512(b'abc').hexdigest() = 实际值
  let msg : FixedArray[Byte] = [
    0x61, 0x62, 0x63, // "abc"
  ]
  let expected : FixedArray[Byte] = [
    0xdd, 0xaf, 0x35, 0xa1, 0x93, 0x61, 0x7a, 0xba, 0xcc, 0x41, 0x73, 0x49, 0xae,
    0x20, 0x41, 0x31, 0x12, 0xe6, 0xfa, 0x4e, 0x89, 0xa9, 0x7e, 0xa2, 0x0a, 0x9e,
    0xee, 0xe6, 0x4b, 0x55, 0xd3, 0x9a, 0x21, 0x92, 0x99, 0x2a, 0x27, 0x4f, 0xc1,
    0xa8, 0x36, 0xba, 0x3c, 0x23, 0xa3, 0xfe, 0xeb, 0xbd, 0x45, 0x4d, 0x44, 0x23,
    0x64, 0x3c, 0xe8, 0x0e, 0x2a, 0x9a, 0xc9, 0x4f, 0xa5, 0x4c, 0xa4, 0x9f, 0xb1,
    0xf1, 0xd2, 0x6f, 0x5c, 0x69, 0x30, 0x4c,
  ]
  let h = sha512(msg)
  for i = 0; i < 64; i = i + 1 {
    if h[i] != expected[i] {
      println(
        "V#1 first diff at i=\{i}: h[i]=\{h[i].to_uint()} expected[i]=\{expected[i].to_uint()}",
      )
      break
    }
  }
  for i = 0; i < 64; i = i + 1 {
    assert_eq(h[i], expected[i])
  }
}

///|
test "fips_180_4_test_2_56bytes" {
  // FIPS 180-4 § A.2 Test 2: 56 字节
  // Python hashlib 实际值
  let msg : FixedArray[Byte] = [
    0x61, 0x62, 0x63, 0x64, 0x62, 0x63, 0x64, 0x65, 0x63, 0x64, 0x65, 0x66, 0x64,
    0x65, 0x66, 0x67, 0x65, 0x66, 0x67, 0x68, 0x66, 0x67, 0x68, 0x69, 0x67, 0x68,
    0x69, 0x6a, 0x68, 0x69, 0x6a, 0x6b, 0x69, 0x6a, 0x6b, 0x6c, 0x6a, 0x6b, 0x6c,
    0x6d, 0x6b, 0x6c, 0x6d, 0x6e, 0x6c, 0x6d, 0x6e, 0x6f, 0x6d, 0x6e, 0x6f, 0x70,
    0x6e, 0x6f, 0x70, 0x71,
  ]
  let expected : FixedArray[Byte] = [
    0x20, 0x4a, 0x8f, 0xc6, 0xdd, 0xa8, 0x2f, 0x0a, 0x0c, 0xed, 0x7b, 0xeb, 0x8e,
    0x08, 0xa4, 0x16, 0x57, 0xc1, 0x6e, 0xf4, 0x68, 0xb2, 0x28, 0xa8, 0x27, 0x9b,
    0xe3, 0x31, 0xa7, 0x03, 0xc3, 0x35, 0x96, 0xfd, 0x15, 0xc1, 0x3b, 0x1b, 0x07,
    0xf9, 0xaa, 0x1d, 0x3b, 0xea, 0x57, 0x78, 0x9c, 0xa0, 0x31, 0xad, 0x85, 0xc7,
    0xa7, 0x1d, 0xd7, 0x03, 0x54, 0xec, 0x63, 0x12, 0x38, 0xca, 0x34, 0x45,
  ]
  let h = sha512(msg)
  for i = 0; i < 64; i = i + 1 {
    assert_eq(h[i], expected[i])
  }
}

