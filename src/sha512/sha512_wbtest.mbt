    0xe4, 0x33, 0x1b, 0x99, 0xde, 0xc4, 0xb5, 0x43, 0x3a, 0xc7, 0xd3, 0x29, 0xee,
    0xb6, 0xdd, 0x26, 0x54, 0x5e, 0x96, 0xe5, 0x5b, 0x87, 0x4b, 0xe9, 0x09,
  ]
  let h = sha512(msg)
  for i = 0; i < 64; i = i + 1 {
    assert_eq(h[i], expected[i])
  }
}

///|
test "rfc_6234_test_4_alpha_26b" {
  // RFC 6234 Test 4: "abcdefghijklmnopqrstuvwxyz" (26 bytes)
  let msg : FixedArray[Byte] = [
    0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x6d,
    0x6e, 0x6f, 0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7a,
  ]
  let expected : FixedArray[Byte] = [
    0x4d, 0xbf, 0xf8, 0x6c, 0xc2, 0xca, 0x1b, 0xae, 0x1e, 0x16, 0x46, 0x8a, 0x05,
    0xcb, 0x98, 0x81, 0xc9, 0x7f, 0x17, 0x53, 0xbc, 0xe3, 0x61, 0x90, 0x34, 0x89,
    0x8f, 0xaa, 0x1a, 0xab, 0xe4, 0x29, 0x95, 0x5a, 0x1b, 0xf8, 0xec, 0x48, 0x3d,
    0x74, 0x21, 0xfe, 0x3c, 0x16, 0x46, 0x61, 0x3a, 0x59, 0xed, 0x54, 0x41, 0xfb,
    0x0f, 0x32, 0x13, 0x89, 0xf7, 0x7f, 0x48, 0xa8, 0x79, 0xc7, 0xb1, 0xf1,
  ]
  let h = sha512(msg)
  for i = 0; i < 64; i = i + 1 {
    if h[i] != expected[i] {
      println(
        "V#4 first diff at i=\{i}: h[i]=\{h[i].to_uint()} expected[i]=\{expected[i].to_uint()}",
      )
      break
    }
  }
  for i = 0; i < 64; i = i + 1 {
    assert_eq(h[i], expected[i])
  }
}

///|
test "fips_180_2_section_C_3_one_million_a" {
  // FIPS 180-2 § C.3 Test 3: "a" repeated 1,000,000 times
  // Long-message stress test. Build via FixedArray::make to keep the
  // source file small (1 MB literal would be silly).
  let msg : FixedArray[Byte] = FixedArray::make(1000000, b'\x61')
  let expected : FixedArray[Byte] = [
    0xe7, 0x18, 0x48, 0x3d, 0x0c, 0xe7, 0x69, 0x64, 0x4e, 0x2e, 0x42, 0xc7, 0xbc,
    0x15, 0xb4, 0x63, 0x8e, 0x1f, 0x98, 0xb1, 0x3b, 0x20, 0x44, 0x28, 0x56, 0x32,
    0xa8, 0x03, 0xaf, 0xa9, 0x73, 0xeb, 0xde, 0x0f, 0xf2, 0x44, 0x87, 0x7e, 0xa6,
    0x0a, 0x4c, 0xb0, 0x43, 0x2c, 0xe5, 0x77, 0xc3, 0x1b, 0xeb, 0x00, 0x9c, 0x5c,
    0x2c, 0x49, 0xaa, 0x2e, 0x4e, 0xad, 0xb2, 0x17, 0xad, 0x8c, 0xc0, 0x9b,
  ]
  let h = sha512(msg)
  for i = 0; i < 64; i = i + 1 {
    assert_eq(h[i], expected[i])
  }
}
