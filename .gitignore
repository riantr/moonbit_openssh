# === Build outputs ===

# MoonBit
_build/
target/
.moonagent/
.mooncakes/
*.mi
*.mo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# === Compiled / binary artifacts ===

# C / C++ build outputs
*.exe
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib

# JavaScript / TypeScript
node_modules/
*.js.map
*.tsbuildinfo

# Rust / Cargo
target/
Cargo.lock

# === Generated / transient files ===

# MoonBit test sandboxes
_test_sb_*/

# Debug-only directories (kept on disk for reference, not committed)
src/test_nested/

# Python bytecode / compiled
__pycache__/
*.pyc
*.pyo

# Logs (transient debugging output)
*.log
_*.log
_*.txt
_*.done
_hmac_sha512_*.log
_sha256_*.done

# Backup files
*.bak

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor configs (optional per-project)
.idea/
.vscode/
*.swp
*.swo
*~

# === Loop runtime state (regenerated by host/verify_loop*.mjs) ===
# sshd host keys, the generated sshd_config, its log, and the raw packet
# captures. Everything in here is derived; nothing here is source.
.loop*/

# === Deliberately untracked package interfaces ===
# These two are generated for local convenience but are NOT part of the
# source: they describe packages that also build for js/wasm, where the
# generated interface drifts with the target. Every other pkg.generated.mbti
# IS tracked.
src/sshclient/pkg.generated.mbti
src/wtlive/pkg.generated.mbti

# === Third-party vendored source (keep) ===
# Do NOT ignore *.c, *.h, *.py, *.json in src/ and verify_c/ etc.

# === CI run artifacts (a report from one run, not source) ===
# ci/artifacts/ci.json changes on every run; committing it turns a
# CI report into a diff in an unrelated loop.
ci/artifacts/
