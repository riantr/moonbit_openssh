@echo off
REM Loop #13 known_hosts C harness: standalone SHA-1 + HMAC-SHA1 + base64 + NFA + parse + check
REM Reads _knownhosts_kat.h, generated by gen_knownhosts_test.py from _knownhosts_ref_out.txt
REM Compiled and run directly for byte-exact verification.
REM
REM Comments here are ASCII on purpose. cmd reads a .bat in the OEM code page, and
REM a CJK comment line gets split into several byte sequences that cmd then tries to
REM execute -- the run still succeeds, but the output is buried under lines like
REM "'<garbled>' is not recognized as an internal or external command". That noise is
REM how Loop #56 first read a genuine 24/28 regression as a build break. Do not put
REM non-ASCII text in this file.

REM Loop #71: this used to be
REM   set GCC=D:\llvm-mingw\llvm-mingw-20260602-ucrt-x86_64\bin\gcc.exe
REM a path that exists on exactly one machine in this repository's history. On
REM a GitHub windows-latest runner it expanded to a path that is not there, and
REM the only line the gate could show was the batch's own echo:
REM   BUILD FAILED / The system cannot find the path specified.
REM build_poly1305.bat already resolved this correctly with `where`. The other
REM eight had not heard of it. Same rule now, in all nine -- and a missing
REM compiler says so by name, because "no compiler" and "compiler failed" are
REM different failures and the second used to hide the first.
if defined GCC goto :cc_ready
where gcc >nul 2>&1
if not errorlevel 1 (
  set GCC=gcc
  goto :cc_ready
)
where clang >nul 2>&1
if not errorlevel 1 (
  set GCC=clang
  goto :cc_ready
)
echo no C compiler on PATH: neither gcc nor clang was found
exit /b 1
:cc_ready
echo using %GCC%
cd /d "%~dp0"

REM Delete the previous binary first (the same reason build_ed25519.bat does). If a
REM later compile fails without deleting, the stale .exe still runs and answers for a
REM tree that was never built -- the Loop #47 failure, one level down.
if exist knownhosts_kat.exe del /q knownhosts_kat.exe

echo Building knownhosts_kat.exe ...
%GCC% -O2 -Wall -o knownhosts_kat.exe knownhosts_harness.c -lm
if %ERRORLEVEL% NEQ 0 (
  echo BUILD FAILED
  exit /b 1
)
echo BUILD OK
echo.
.\knownhosts_kat.exe
exit /b %ERRORLEVEL%